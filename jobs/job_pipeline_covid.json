{
  "name": "pipeline_covid_hospitalizacion",
  "description": "Medallion (bronze → silver → gold) + entrenamiento + publicación del endpoint. Reemplaza <TU_CORREO> por tu usuario de Databricks.",
  "schedule": {
    "quartz_cron_expression": "0 0 6 ? * MON",
    "timezone_id": "America/Mexico_City",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<TU_CORREO>/covid-hospitalizacion-mx/notebooks/01_bronze",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<TU_CORREO>/covid-hospitalizacion-mx/notebooks/02_silver",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<TU_CORREO>/covid-hospitalizacion-mx/notebooks/03_gold",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "entrenamiento",
      "depends_on": [{ "task_key": "gold" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<TU_CORREO>/covid-hospitalizacion-mx/notebooks/04_entrenamiento",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "publicar_endpoint",
      "depends_on": [{ "task_key": "entrenamiento" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<TU_CORREO>/covid-hospitalizacion-mx/notebooks/05_publicar_endpoint",
        "source": "WORKSPACE"
      }
    }
  ]
}
